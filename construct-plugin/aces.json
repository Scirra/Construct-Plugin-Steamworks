{
	"$schema": "../aces.schema.json",
	
	"steamworks": {
		"conditions": [
			{
				"id": "is-available",
				"scriptName": "IsAvailable"
			}, {
				"id": "is-running-on-steam-deck",
				"scriptName": "IsRunningOnSteamDeck",
				"isDeprecated": true
			}, {
				"id": "is-running-on-steam-hardware",
				"scriptName": "IsRunningOnSteamHardware",
				"params": [{
					"id": "steam-hardware",
					"type": "combo",
					"items": ["none", "steam-deck", "steam-machine", "steam-frame", "any"]
				}]
			}, {
				"id": "on-overlay-shown",
				"isDeprecated": true,
				"scriptName": "OnGameOverlayShown",
				"isTrigger": true
			}, {
				"id": "on-overlay-hidden",
				"isDeprecated": true,
				"scriptName": "OnGameOverlayHidden",
				"isTrigger": true
			}
		],
		"actions": [
			{
				"id": "show-overlay",
				"scriptName": "ShowOverlay",
				"params": [{
					"id": "option",
					"type": "combo",
					"items": ["friends", "community", "players", "settings", "official-game-group", "stats", "achievements"]
				}]
			}, {
				"id": "show-overlay-url",
				"scriptName": "ShowOverlayURL",
				"params": [{
					"id": "url",
					"type": "string",
					"initialValue": "\"https://www.construct.net\""
				}, {
					"id": "modal",
					"type": "boolean"
				}]
			}, {
				"id": "show-overlay-invite-dialog",
				"scriptName": "ShowOverlayInviteDialog",
				"params": [{	"id": "lobby-id",		"type": "string"		}]
			}, {
				"id": "trigger-screenshot",
				"scriptName": "TriggerScreenshot"
			}
		],
		"expressions": [
			{
				"id": "account-id",
				"expressionName": "AccountID",
				"returnType": "number"
			}, {
				"id": "static-account-key",
				"expressionName": "StaticAccountKey",
				"returnType": "string"
			}, {
				"id": "steam-id-64-bit",
				"expressionName": "SteamID64Bit",
				"returnType": "string"
			}, {
				"id": "app-owner-account-id",
				"expressionName": "AppOwnerAccountID",
				"returnType": "number"
			}, {
				"id": "app-owner-steam-id-64-bit",
				"expressionName": "AppOwnerSteamID64Bit",
				"returnType": "string"
			}, {
				"id": "app-owner-static-account-key",
				"expressionName": "AppOwnerStaticAccountKey",
				"returnType": "string"
			}, {
				"id": "persona-name",
				"expressionName": "PersonaName",
				"returnType": "string"
			}, {
				"id": "player-steam-level",
				"expressionName": "PlayerSteamLevel",
				"returnType": "number"
			}, {
				"id": "app-id",
				"expressionName": "AppID",
				"returnType": "number"
			}, {
				"id": "steam-ui-language",
				"expressionName": "SteamUILanguage",
				"returnType": "string"
			}, {
				"id": "current-game-language",
				"expressionName": "CurrentGameLanguage",
				"returnType": "string"
			}, {
				"id": "available-game-languages",
				"expressionName": "AvailableGameLanguages",
				"returnType": "string"
			}
		]
	},
	"stats-achievements": {
		"conditions": [
			{
				"id": "on-any-achievement-unlock-success",
				"scriptName": "OnAnyAchievementUnlockSuccess",
				"isTrigger": true
			}, {
				"id": "on-achievement-unlock-success",
				"scriptName": "OnAchievementUnlockSuccess",
				"isTrigger": true,
				"params": [{
					"id": "achievement",
					"type": "string"
				}]
			}, {
				"id": "on-any-achievement-unlock-error",
				"scriptName": "OnAnyAchievementUnlockError",
				"isTrigger": true
			}, {
				"id": "on-achievement-unlock-error",
				"scriptName": "OnAchievementUnlockError",
				"isTrigger": true,
				"params": [{
					"id": "achievement",
					"type": "string"
				}]
			}, {
				"id": "on-any-get-achievement-info-success",
				"scriptName": "OnAnyGetAchievementInfoSuccess",
				"isTrigger": true
			}, {
				"id": "on-get-achievement-info-success",
				"scriptName": "OnGetAchievementInfoSuccess",
				"isTrigger": true,
				"params": [{
					"id": "achievement",
					"type": "string"
				}]
			}, {
				"id": "on-any-get-achievement-info-error",
				"scriptName": "OnAnyGetAchievementInfoError",
				"isTrigger": true
			}, {
				"id": "on-get-achievement-info-error",
				"scriptName": "OnGetAchievementInfoError",
				"isTrigger": true,
				"params": [{
					"id": "achievement",
					"type": "string"
				}]
			}, {
				"id": "achievement-is-achieved",
				"scriptName": "AchievementIsAchieved"
			}, {
				"id": "on-any-get-stat",
				"scriptName": "OnAnyGetStat",
				"isTrigger": true
			}, {
				"id": "on-get-stat",
				"scriptName": "OnGetStat",
				"isTrigger": true,
				"params": [{
					"id": "name",
					"type": "string"
				}]
			}
		],
		"actions": [
			{
				"id": "unlock-achievement",
				"scriptName": "UnlockAchievement",
				"isAsync": true,
				"params": [{
					"id": "achievement",
					"type": "string"
				}]
			}, {
				"id": "clear-achievement",
				"scriptName": "ClearAchievement",
				"isAsync": true,
				"params": [{
					"id": "achievement",
					"type": "string"
				}]
			}, {
				"id": "get-achievement-info",
				"scriptName": "GetAchievementInfo",
				"isAsync": true,
				"params": [{
					"id": "achievement",
					"type": "string"
				}]
			}, {
				"id": "set-stat",
				"scriptName": "SetStat",
				"isAsync": true,
				"params": [{
					"id": "name",
					"type": "string"
				}, {
					"id": "value",
					"type": "number"
				}, {
					"id": "type",
					"type": "combo",
					"items": ["integer", "float"]
				}]
			}, {
				"id": "get-stat",
				"scriptName": "GetStat",
				"isAsync": true,
				"params": [{
					"id": "name",
					"type": "string"
				}, {
					"id": "type",
					"type": "combo",
					"items": ["integer", "float"]
				}]
			}, {
				"id": "store-stats",
				"scriptName": "StoreStats",
				"isAsync": true
			}, {
				"id": "reset-all-stats",
				"scriptName": "ResetAllStats",
				"isAsync": true,
				"params": [{
					"id": "achievements-too",
					"type": "boolean"
				}]
			}
		],
		"expressions": [
			{
				"id": "achievement",
				"expressionName": "Achievement",
				"returnType": "string"
			}, {
				"id": "achievement-unlock-time",
				"expressionName": "AchievementUnlockTime",
				"returnType": "number"
			}, {
				"id": "stat-value",
				"expressionName": "StatValue",
				"returnType": "number"
			}, {
				"id": "stat-name",
				"expressionName": "StatName",
				"returnType": "string"
			}
		]
	},
	"leaderboards": {
		"conditions": [{
			"id":"on-any-upload-leaderboard-score-success",
			"scriptName": "OnAnyUploadLeaderboardScoreSuccess",
			"isTrigger": true
		}, {
			"id":"on-upload-leaderboard-score-success",
			"scriptName": "OnUploadLeaderboardScoreSuccess",
			"isTrigger": true,
			"params": [{	"id": "leaderboard-name",	"type": "string" }]
		}, {
			"id":"on-any-upload-leaderboard-score-error",
			"scriptName": "OnAnyUploadLeaderboardScoreError",
			"isTrigger": true
		}, {
			"id":"on-upload-leaderboard-score-error",
			"scriptName": "OnUploadLeaderboardScoreError",
			"isTrigger": true,
			"params": [{	"id": "leaderboard-name",	"type": "string" }]
		}, {
			"id": "did-score-change",
			"scriptName": "DidScoreChange"
		}, {
			"id":"on-any-download-leaderboard-entries-success",
			"scriptName": "OnAnyDownloadLeaderboardEntriesSuccess",
			"isTrigger": true
		}, {
			"id":"on-download-leaderboard-entries-success",
			"scriptName": "OnDownloadLeaderboardEntriesSuccess",
			"isTrigger": true,
			"params": [{	"id": "leaderboard-name",	"type": "string" }]
		}, {
			"id":"on-any-download-leaderboard-entries-error",
			"scriptName": "OnAnyDownloadLeaderboardEntriesError",
			"isTrigger": true
		}, {
			"id":"on-download-leaderboard-entries-error",
			"scriptName": "OnDownloadLeaderboardEntriesError",
			"isTrigger": true,
			"params": [{	"id": "leaderboard-name",	"type": "string" }]
		}],
		"actions": [{
			"id": "upload-leaderboard-score",
			"scriptName": "UploadLeaderboardScore",
			"isAsync": true,
			"params": [{	"id": "leaderboard-name",	"type": "string"	},
					   {	"id": "score",				"type": "number"	},
					   {	"id": "force-update",		"type": "boolean"	}]
		}, {
			"id": "download-leaderboard-entries",
			"scriptName": "DownloadLeaderboardEntries",
			"isAsync": true,
			"params": [{	"id": "leaderboard-name",	"type": "string"	},
					   {	"id": "data",				"type": "combo",	"items": ["global", "global-around-user", "friends"]	},
					   {	"id": "start",				"type": "number"	},
					   {	"id": "end",				"type": "number"	}]
		}],
		"expressions": [{
			"id": "global-rank-new",
			"expressionName": "GlobalRankNew",
			"returnType": "number"
		}, {
			"id": "global-rank-previous",
			"expressionName": "GlobalRankPrevious",
			"returnType": "number"
		}, {
			"id": "leaderboard-name",
			"expressionName": "LeaderboardName",
			"returnType": "string"
		}, {
			"id": "leaderboard-entry-count",
			"expressionName": "LeaderboardEntryCount",
			"returnType": "number",
			"params": [{	"id": "leaderboard-name",	"type": "string"	}]
		}, {
			"id": "leaderboard-entry-name-at",
			"expressionName": "LeaderboardEntryNameAt",
			"returnType": "string",
			"params": [{	"id": "leaderboard-name",	"type": "string"	},
					   {	"id": "index",				"type": "number"	}]
		}, {
			"id": "leaderboard-entry-rank-at",
			"expressionName": "LeaderboardEntryRankAt",
			"returnType": "number",
			"params": [{	"id": "leaderboard-name",	"type": "string"	},
					   {	"id": "index",				"type": "number"	}]
		}, {
			"id": "leaderboard-entry-score-at",
			"expressionName": "LeaderboardEntryScoreAt",
			"returnType": "number",
			"params": [{	"id": "leaderboard-name",	"type": "string"	},
					   {	"id": "index",				"type": "number"	}]
		}]
	},
	"dlc": {
		"conditions": [{
			"id": "on-dlc-installed-check-complete",
			"scriptName": "OnDLCInstalledCheckComplete",
			"isTrigger": true
		}, {
			"id": "is-dlc-installed",
			"scriptName": "IsDLCInstalled",
			"params": [{	"id": "app-id",		"type": "number" }]
		}, {
			"id": "on-dlc-installed",
			"scriptName": "OnDLCInstalled",
			"isTrigger": true
		}],
		"actions": [{
			"id": "check-dlc-installed",
			"scriptName": "CheckDLCInstalled",
			"isAsync": true,
			"params": [{	"id": "app-ids",	"type": "any" }]
		}, {
			"id": "install-dlc",
			"scriptName": "InstallDLC",
			"params": [{	"id": "app-id",		"type": "number" }]
		}, {
			"id": "uninstall-dlc",
			"scriptName": "UninstallDLC",
			"params": [{	"id": "app-id",		"type": "number" }]
		}],
		"expressions": [{
			"id": "trigger-app-id",
			"expressionName": "TriggerAppID",
			"returnType": "number"
		}]
	},
	"authentication": {
		"conditions": [{
			"id": "on-get-auth-ticket-for-web-api-success",
			"scriptName": "OnGetAuthTicketForWebApiSuccess",
			"isTrigger": true
		}, {
			"id": "on-get-auth-ticket-for-web-api-error",
			"scriptName": "OnGetAuthTicketForWebApiError",
			"isTrigger": true
		}],
		"actions": [{
			"id": "get-auth-ticket-for-web-api",
			"scriptName": "GetAuthTicketForWebApi",
			"isAsync": true,
			"params": [{	"id": "identity",		"type": "string"	}]
		}, {
			"id": "cancel-auth-ticket",
			"scriptName": "CancelAuthTicket",
			"params": [{	"id": "auth-ticket",	"type": "number"	}]
		}],
		"expressions": [{
			"id": "auth-ticket",
			"expressionName": "AuthTicket",
			"returnType": "number"
		}, {
			"id": "ticket-hex-str",
			"expressionName": "TicketHexStr",
			"returnType": "string"
		}]
	},
	"rich-presence": {
		"actions": [{
			"id": "set-rich-presence",
			"scriptName": "SetRichPresence",
			"params": [{	"id": "key",		"type": "string"	},
					   {	"id": "value",		"type": "string"	}]
		}, {
			"id": "clear-rich-presence",
			"scriptName": "ClearRichPresence"
		}]
	}
}